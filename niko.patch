+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Quickshell.Wayland
+import Quickshell.Hyprland
+import "../"
+
+PanelWindow {
+    id: nikoWindow
+
+    screen: Quickshell.screens[0]
+    anchors { top: true; bottom: true; left: true; right: true }
+    exclusionMode: ExclusionMode.Ignore
+    color: "transparent"
+    visible: true
+    focusable: pet.chatOpen
+
+    WlrLayershell.namespace: "qs-niko"
+    WlrLayershell.layer: WlrLayer.Overlay
+
+    mask: Region {
+        Region { item: pet.place === "held" ? wholeScreen : null }
+        Region { item: pet.visible ? pet.hitArea : null }
+        Region { item: pet.visible && pet.bubbleVisible ? pet.bubbleArea : null }
+    }
+
+    Item { id: wholeScreen; anchors.fill: parent }
+
+    QtObject {
+        id: info
+        property int elementSize: 32
+        property bool fullscreen: false
+        property bool fsNow: false
+        property bool cheering: false
+        readonly property bool hidden: fsNow && !cheering
+        property bool barAvailable: false
+        property real barTop: 0
+        property real barBottom: 0
+        property bool dockShown: false
+        property real dockLeft: 0
+        property real dockRight: 0
+        property real dockTop: 0
+        function s(v) { return Scaler.s(v); }
+    }
+
+    FileView {
+        path: Quickshell.env("XDG_RUNTIME_DIR") + "/serpantinum/niko/dock.json"
+        watchChanges: true
+        onFileChanged: reload()
+        onLoaded: {
+            try {
+                let d = JSON.parse(typeof text === "function" ? text() : text);
+                for (let k in d) if (k in info) info[k] = d[k];
+            } catch (e) {}
+        }
+    }
+
+    Process {
+        id: fsCheck
+        property bool again: false
+        command: ["hyprctl", "-j", "activeworkspace"]
+        stdout: StdioCollector {
+            onStreamFinished: { try { info.fsNow = JSON.parse(text).hasfullscreen === true; } catch (e) {} }
+        }
+        onRunningChanged: if (!running && again) { again = false; running = true; }
+    }
+    Connections {
+        target: Hyprland
+        function onRawEvent(event) {
+            if (["fullscreen", "workspacev2", "focusedmonv2", "activewindowv2", "closewindow", "openwindow", "movewindowv2"].indexOf(event.name) === -1) return;
+            if (event.name === "fullscreen") info.fsNow = (event.data || "").trim() === "1";
+            if (fsCheck.running) fsCheck.again = true; else fsCheck.running = true;
+        }
+    }
+    Component.onCompleted: fsCheck.running = true
+
+    NikoPet {
+        id: pet
+        info: info
+    }
+}

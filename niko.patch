@@ -0,0 +1,392 @@
+#!/usr/bin/env python3
+import os, sys, time, json, signal, shutil, subprocess, datetime
+
+HOME = os.path.expanduser("~")
+SRC = os.environ.get("SERPANTINUM_DIR") or os.path.join(HOME, ".local/share/serpantinum/src")
+SHELL_QML = os.path.join(SRC, "quickshell", "NikoShell.qml")
+STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "serpantinum", "niko")
+RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "serpantinum", "niko")
+PIDFILE = os.path.join(RUN, "niko.pid")
+LOGFILE = os.path.join(RUN, "niko.log")
+DISABLED = os.path.join(STATE, "disabled")
+CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "serpantinum", "niko.json")
+CLK = os.sysconf("SC_CLK_TCK")
+
+BOLD, DIM, OK, BAD, RESET = ("\033[1m", "\033[2m", "\033[32m", "\033[31m", "\033[0m") if sys.stdout.isatty() else ("",) * 5
+
+
+def read(path, default=""):
+    try:
+        with open(path) as f:
+            return f.read()
+    except Exception:
+        return default
+
+
+def load_json(path):
+    try:
+        return json.loads(read(path, "{}"))
+    except Exception:
+        return {}
+
+
+def is_niko(pid):
+    return SHELL_QML.encode() in read_bytes(f"/proc/{pid}/cmdline")
+
+
+def read_bytes(path):
+    try:
+        with open(path, "rb") as f:
+            return f.read()
+    except Exception:
+        return b""
+
+
+def watcher_pids():
+    me = os.getpid()
+    return [int(d) for d in os.listdir("/proc") if d.isdigit() and int(d) != me
+            and read_bytes(f"/proc/{d}/cmdline").split(b"\0")[1:3] == [os.path.realpath(__file__).encode(), b"_watch"]]
+
+
+def rpc_pids():
+    script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "niko_rpc.py").encode()
+    return [int(d) for d in os.listdir("/proc") if d.isdigit() and script in read_bytes(f"/proc/{d}/cmdline").split(b"\0")[:3]]
+
+
+def find_pid():
+    try:
+        pid = int(read(PIDFILE).strip())
+        if is_niko(pid):
+            return pid
+    except ValueError:
+        pass
+    for d in os.listdir("/proc"):
+        if d.isdigit() and is_niko(int(d)):
+            return int(d)
+    return None
+
+
+def shell_env():
+    env = dict(os.environ, SERPANTINUM_DIR=SRC)
+    try:
+        out = subprocess.run(["bash", "-c", 'source "$SERPANTINUM_DIR/scripts/caching.sh" >/dev/null 2>&1; env -0'],
+                             env=env, capture_output=True, timeout=10).stdout
+        for item in out.split(b"\0"):
+            k, sep, v = item.partition(b"=")
+            if sep:
+                env[k.decode(errors="replace")] = v.decode(errors="replace")
+    except Exception:
+        pass
+    return env
+
+
+def run(auto=False):
+    if auto and os.path.exists(DISABLED):
+        return 0
+    if not auto and os.path.exists(DISABLED):
+        os.remove(DISABLED)
+    pid = find_pid() or (watcher_pids() or [None])[0]
+    if pid:
+        if not auto:
+            print(f"Niko is already running (pid {pid}).")
+        return 0
+    qs = shutil.which("quickshell") or shutil.which("qs")
+    if not qs:
+        print("Can't find quickshell.")
+        return 1
+    if not os.environ.get("WAYLAND_DISPLAY"):
+        print("Niko needs your desktop session; run this from a terminal inside Hyprland.")
+        return 1
+    if not os.path.exists(SHELL_QML):
+        print(f"Niko's files are missing ({SHELL_QML}). Run ~/.config/serpantinum-mods/apply.sh")
+        return 1
+    os.makedirs(RUN, exist_ok=True)
+    if not rpc_pids():
+        subprocess.Popen([sys.executable, os.path.join(os.path.dirname(os.path.realpath(__file__)), "niko_rpc.py")],
+                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
+    with open(LOGFILE, "w") as log:
+        proc = subprocess.Popen([sys.executable, os.path.realpath(__file__), "_watch"], stdin=subprocess.DEVNULL, stdout=log,
+                                stderr=subprocess.STDOUT, start_new_session=True, cwd=HOME, env=shell_env())
+    for _ in range(30):
+        time.sleep(0.1)
+        if proc.poll() is not None:
+            print(f"{BAD}Niko couldn't start.{RESET} Last lines of {LOGFILE}:")
+            print("\n".join(read(LOGFILE).splitlines()[-8:]))
+            return 1
+    pid = find_pid()
+    if not auto:
+        print(f"{OK}Niko is running{RESET} (pid {pid or proc.pid}).")
+    return 0
+
+
+def watch():
+    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
+    qs = shutil.which("quickshell") or shutil.which("qs")
+    env = dict(shell_env(), QS_DISABLE_CRASH_HANDLER="1")
+    starts = []
+    return _watch_loop(qs, env, starts)
+
+
+def _watch_loop(qs, env, starts):
+    while not os.path.exists(DISABLED):
+        now = time.time()
+        starts = [t for t in starts if now - t < 120]
+        if len(starts) >= 5:
+            return 1
+        starts.append(now)
+        with open(LOGFILE, "a") as log:
+            proc = subprocess.Popen([qs, "-p", SHELL_QML], stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
+                                    cwd=HOME, env=env)
+        with open(PIDFILE, "w") as f:
+            f.write(str(proc.pid))
+        if proc.wait() == 0:
+            return 0
+        time.sleep(2)
+    return 0
+
+
+def kill(keep_rpc=False):
+    os.makedirs(STATE, exist_ok=True)
+    open(DISABLED, "w").close()
+    for w in watcher_pids() + ([] if keep_rpc else rpc_pids()):
+        os.kill(w, signal.SIGTERM)
+    pid = find_pid()
+    if not pid:
+        print("Niko isn't running. (Niko will stay off until `niko run`.)")
+        return 0
+    os.kill(pid, signal.SIGTERM)
+    for _ in range(30):
+        time.sleep(0.1)
+        if not is_niko(pid):
+            break
+    else:
+        os.kill(pid, signal.SIGKILL)
+    try:
+        os.remove(PIDFILE)
+    except FileNotFoundError:
+        pass
+    print("Niko stopped. Niko stays off after restarts until you run `niko run`.")
+    return 0
+
+
+def proc_ticks(pid):
+    f = read(f"/proc/{pid}/stat").rsplit(")", 1)[-1].split()
+    return int(f[11]) + int(f[12]), int(f[13]) + int(f[14]), int(f[19])
+
+
+def descendants(pid):
+    kids = {}
+    for d in os.listdir("/proc"):
+        if d.isdigit():
+            st = read(f"/proc/{d}/stat").rsplit(")", 1)
+            if len(st) == 2:
+                kids.setdefault(int(st[1].split()[1]), []).append(int(d))
+    out, todo = [], [pid]
+    while todo:
+        for c in kids.get(todo.pop(), []):
+            out.append(c)
+            todo.append(c)
+    return out
+
+
+def pss_kib(pid):
+    for line in read(f"/proc/{pid}/smaps_rollup").splitlines():
+        if line.startswith("Pss:"):
+            return int(line.split()[1])
+    return 0
+
+
+def gpu_sample(pid):
+    clients = {}
+    try:
+        fds = os.listdir(f"/proc/{pid}/fdinfo")
+    except Exception:
+        return {}
+    for fd in fds:
+        info = {}
+        for line in read(f"/proc/{pid}/fdinfo/{fd}").splitlines():
+            if line.startswith("drm-"):
+                k, _, v = line.partition(":")
+                info[k.strip()] = v.strip()
+        cid = info.get("drm-client-id")
+        if cid and cid not in clients:
+            clients[cid] = info
+    engines, mem = {}, {}
+    driver = ""
+    for info in clients.values():
+        driver = info.get("drm-driver", driver)
+        for k, v in info.items():
+            if k.startswith("drm-engine-") and not k.startswith("drm-engine-capacity"):
+                engines[k[11:]] = engines.get(k[11:], 0) + int(v.split()[0])
+            elif k.startswith(("drm-memory-", "drm-resident-")) and v.endswith("KiB"):
+                mem[k] = mem.get(k, 0) + int(v.split()[0])
+    return {"driver": driver, "engines": engines, "mem": mem}
+
+
+def fmt_kib(kib):
+    return f"{kib / 1024:.1f} MiB" if kib < 1024 * 1024 else f"{kib / 1048576:.2f} GiB"
+
+
+def fmt_dur(sec):
+    sec = int(sec)
+    h, m = sec // 3600, (sec % 3600) // 60
+    return f"{h}h {m}m" if h else (f"{m}m {sec % 60}s" if m else f"{sec}s")
+
+
+def fmt_tokens(n):
+    return f"{n / 1000:.1f}k" if n >= 10000 else str(n)
+
+
+def status():
+    pid = find_pid()
+    off = os.path.exists(DISABLED)
+    print(f"{BOLD}Niko{RESET}")
+    if not pid:
+        print(f"  state      {BAD}not running{RESET}" + ("  (turned off, `niko run` to start)" if off else "  (`niko run` to start)"))
+    else:
+        uptime = float(read("/proc/uptime", "0").split()[0])
+        own0, kids0, start = proc_ticks(pid)
+        helpers = descendants(pid)
+        h0 = {c: sum(proc_ticks(c)[:1]) for c in helpers if read(f"/proc/{c}/stat")}
+        g0, t0 = gpu_sample(pid), time.time()
+        time.sleep(1.0)
+        own1, kids1, _ = proc_ticks(pid)
+        h1 = {c: sum(proc_ticks(c)[:1]) for c in h0 if read(f"/proc/{c}/stat")}
+        g1, t1 = gpu_sample(pid), time.time()
+        elapsed = max(1e-6, uptime - start / CLK)
+        cpu_now = 100 * (own1 - own0) / CLK / (t1 - t0)
+        cpu_avg = 100 * own1 / CLK / elapsed
+        roll = {}
+        for line in read(f"/proc/{pid}/smaps_rollup").splitlines():
+            parts = line.split()
+            if len(parts) >= 2 and parts[0].endswith(":") and parts[1].isdigit():
+                roll[parts[0][:-1]] = int(parts[1])
+        threads = read(f"/proc/{pid}/status")
+        threads = next((l.split()[1] for l in threads.splitlines() if l.startswith("Threads:")), "?")
+
+        print(f"  state      {OK}running{RESET}  (pid {pid}, up {fmt_dur(elapsed)}, {threads} threads)")
+        print(f"  cpu        {cpu_now:.1f}% now, {cpu_avg:.2f}% average since start")
+        print(f"  ram        {fmt_kib(roll.get('Pss', 0))} (PSS), {fmt_kib(roll.get('Rss', 0))} resident")
+        if h1:
+            names = sorted({os.path.basename(read(f"/proc/{c}/comm").strip()) for c in h1})
+            hcpu = 100 * sum(h1[c] - h0.get(c, h1[c]) for c in h1) / CLK / (t1 - t0)
+            print(f"  brain      {len(h1)} processes ({', '.join(names)}): {hcpu:.1f}% cpu, {fmt_kib(sum(pss_kib(c) for c in h1))} RAM  {DIM}(keeps Claude ready for fast replies){RESET}")
+        if g1.get("engines"):
+            busy = {e: (g1["engines"].get(e, 0) - g0.get("engines", {}).get(e, 0)) / 1e9 / (t1 - t0) * 100 for e in g1["engines"]}
+            main = max(busy, key=lambda e: g1["engines"][e])
+            vram = g1["mem"].get("drm-memory-vram", g1["mem"].get("drm-resident-vram", 0))
+            gtt = g1["mem"].get("drm-memory-gtt", g1["mem"].get("drm-resident-gtt", 0))
+            mem = f"{fmt_kib(vram)} VRAM" + (f", {fmt_kib(gtt)} shared" if gtt else "")
+            extra = ", ".join(f"{e} {v:.1f}%" for e, v in busy.items() if e != main and v >= 0.05)
+            print(f"  gpu        {busy[main]:.1f}% busy ({main}{', ' + extra if extra else ''}), {mem}  {DIM}[{g1['driver']}]{RESET}")
+        else:
+            print(f"  gpu        {DIM}no per-process GPU stats available{RESET}")
+
+    cfg = {"model": "haiku", "dailyLimit": 0, "proactiveLimit": 10}
+    cfg.update(load_json(CONFIG))
+    stats = load_json(os.path.join(STATE, "stats.json"))
+    today = stats.get("days", {}).get(datetime.date.today().isoformat(), {})
+    total = stats.get("total", {})
+
+    def line(b):
+        if not b.get("calls"):
+            return "no chats"
+        inp = b.get("input", 0) + b.get("cacheRead", 0) + b.get("cacheWrite", 0)
+        own = b.get("proactive", 0)
+        return (f"{b['calls']} replies" + (f" ({own} started by Niko)" if own else "") + f", {fmt_tokens(inp)} in / {fmt_tokens(b.get('output', 0))} out"
+                f"  {DIM}(cached reads {fmt_tokens(b.get('cacheRead', 0))}){RESET}")
+
+    limit = int(cfg.get("dailyLimit") or 0)
+    print(f"\n{BOLD}Claude{RESET}  {DIM}model {cfg.get('model')}, " + (f"limit {limit} chats/day" if limit else "no daily limit")
+          + f", Niko starts up to {cfg.get('proactiveLimit')} a day{RESET}")
+    print(f"  today      {line(today)}")
+    print(f"  all time   {line(total)}")
+    last = stats.get("lastCall")
+    if last:
+        print(f"  last chat  {last.get('input', 0) + last.get('cacheRead', 0) + last.get('cacheWrite', 0)} in / {last.get('output', 0)} out tokens  {DIM}({stats.get('lastReply', '')}){RESET}")
+    if total.get("costUsd"):
+        print(f"  {DIM}API-price equivalent so far: ${total['costUsd']:.4f} (on Pro this comes out of your plan's usage, not billed){RESET}")
+    return 0
+
+
+def skins(args):
+    import re, shlex
+    marker = os.path.join(STATE, "skin.txt")
+
+    def clear():
+        for f in os.listdir(STATE) if os.path.isdir(STATE) else []:
+            if f.startswith("skin-"):
+                os.remove(os.path.join(STATE, f))
+
+    def revert():
+        clear()
+        if os.path.exists(marker):
+            os.remove(marker)
+        print("Back to the normal Niko model.")
+        return 0
+
+    if args and args[0] in ("reset", "revert", "default", "normal"):
+        return revert()
+    if args:
+        raw = " ".join(args)
+    else:
+        print(f"{BOLD}Niko skins{RESET}")
+        print(f"  Send the path of an image (png, jpg, webp, gif, bmp, svg); a transparent PNG looks best.")
+        print(f"  Type {BOLD}r{RESET} to go back to the normal model, or press Enter to cancel.")
+        try:
+            raw = input("Image path: ")
+        except (EOFError, KeyboardInterrupt):
+            print()
+            return 1
+    raw = raw.strip()
+    if not raw:
+        return 0
+    if raw.lower() in ("r", "reset", "revert"):
+        return revert()
+    try:
+        parts = shlex.split(raw)
+        raw = parts[0] if len(parts) == 1 else raw
+    except ValueError:
+        pass
+    path = os.path.abspath(os.path.expanduser(re.sub(r"^file://", "", raw)))
+    if not os.path.isfile(path):
+        print(f"{BAD}No such file:{RESET} {path}")
+        return 1
+    ext = os.path.splitext(path)[1].lower()
+    if ext not in (".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".svg"):
+        print(f"{BAD}That doesn't look like an image{RESET} (png, jpg, webp, gif, bmp, svg).")
+        return 1
+    os.makedirs(STATE, exist_ok=True)
+    clear()
+    dest = os.path.join(STATE, f"skin-{int(time.time())}{ext}")
+    shutil.copyfile(path, dest)
+    name = re.sub(r"[_\s]+", " ", os.path.splitext(os.path.basename(path))[0]).strip()[:30] or "Niko"
+    with open(marker, "w") as f:
+        f.write(dest + "\n" + name + "\n")
+    print(f"Niko now looks like {os.path.basename(path)} and goes by the name {name}." + ("" if find_pid() else " (Niko isn't running: `niko run`.)"))
+    print("The name follows the file name. Revert with `niko skins` then r, or `niko skins reset`.")
+    return 0
+
+
+def main():
+    cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
+    if cmd == "run":
+        return run(auto="--auto" in sys.argv[2:])
+    if cmd in ("kill", "stop"):
+        return kill()
+    if cmd == "_watch":
+        return watch()
+    if cmd == "restart":
+        kill(keep_rpc=True)
+        time.sleep(1)
+        return run()
+    if cmd == "skins":
+        return skins(sys.argv[2:])
+    if cmd == "status":
+        return status()
+    print("usage: niko run | kill | restart | status | skins")
+    return 0 if cmd in ("help", "-h", "--help") else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())

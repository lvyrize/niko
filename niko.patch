+#!/usr/bin/env python3
+import os, re, json, random, sqlite3
+
+SONORA_CACHE = os.path.expanduser("~/.cache/sonora/cache.sqlite")
+SONORA_STATE = os.path.expanduser("~/.local/share/sonora/state.sqlite")
+STOP = {"play", "some", "song", "songs", "music", "listen", "listening", "what", "should", "something", "please",
+        "niko", "from", "with", "that", "this", "playlist", "playlists", "track", "tracks", "want", "like", "the", "and"}
+
+
+def _ro(path):
+    return sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2)
+
+
+def _snapshot(con, key):
+    row = con.execute("select value from snapshots where key=?", (key,)).fetchone()
+    return json.loads(row[0]).get("rows", []) if row else []
+
+
+def library():
+    songs, playlists, recent = [], [], []
+    if os.path.exists(SONORA_CACHE):
+        try:
+            con = _ro(SONORA_CACHE)
+            for r in _snapshot(con, "spotify/songs"):
+                if r.get("playable", True):
+                    songs.append({"name": r["name"], "artists": r.get("artists", ""), "uri": "spotify:track:" + r["id"], "src": "spotify"})
+            for r in _snapshot(con, "apple/songs"):
+                if r.get("playable", True):
+                    songs.append({"name": r["name"], "artists": r.get("artists", ""), "uri": "https://music.apple.com/us/song/" + r["id"], "src": "apple"})
+            for r in _snapshot(con, "spotify/playlists"):
+                if r.get("track_count", 1):
+                    playlists.append({"name": r["name"], "tracks": r.get("track_count", 0), "uri": "spotify:playlist:" + r["id"], "src": "spotify"})
+            for r in _snapshot(con, "apple/playlists"):
+                playlists.append({"name": r["name"], "uri": "https://music.apple.com/library/playlist/" + r["id"], "src": "apple"})
+            con.close()
+        except Exception:
+            pass
+    if os.path.exists(SONORA_STATE):
+        try:
+            con = _ro(SONORA_STATE)
+            seen = set()
+            for name, artists, provider, tid in con.execute(
+                    "select name, artists, provider, track_id from plays order by played_at desc limit 60"):
+                if (provider, tid) in seen:
+                    continue
+                seen.add((provider, tid))
+                uri = "spotify:track:" + tid if provider == "spotify" else ("https://music.apple.com/us/song/" + tid if provider == "apple" else "")
+                if uri:
+                    recent.append({"name": name, "artists": artists or "", "uri": uri, "src": provider})
+            con.close()
+        except Exception:
+            pass
+    return {"songs": songs, "playlists": playlists, "recent": recent[:12]}
+
+
+def sonora_provider():
+    if not os.path.exists(SONORA_STATE):
+        return None
+    try:
+        con = _ro(SONORA_STATE)
+        row = con.execute("select provider from plays order by played_at desc limit 1").fetchone()
+        con.close()
+        return row[0] if row else None
+    except Exception:
+        return None
+
+
+def prompt_items(text, lib=None, sources=None):
+    lib = lib or library()
+    if sources:
+        lib = {k: [i for i in v if i["src"] in sources] for k, v in lib.items()}
+    words = [w for w in re.findall(r"[\w']+", text.lower()) if len(w) > 2 and w not in STOP]
+
+    def hits(item):
+        hay = (item["name"] + " " + item.get("artists", "")).lower()
+        return sum(1 for w in words if w in hay)
+
+    picked, codes, lines = [], {}, []
+    matches = sorted((s for s in lib["songs"] if hits(s)), key=hits, reverse=True)[:10] if words else []
+    pl_matches = [p for p in lib["playlists"] if words and hits(p)]
+    pool = [s for s in lib["songs"] if s not in matches]
+    sample = random.sample(pool, min(4 if matches else 10, len(pool)))
+
+    def add(prefix, items, label):
+        if not items:
+            return
+        lines.append(label)
+        for it in items:
+            code = f"{prefix}{len([c for c in codes if c.startswith(prefix)]) + 1}"
+            codes[code] = it
+            extra = f" - {it['artists'][:40]}" if it.get("artists") else ""
+            lines.append(f"{code} {it['name']}{extra}")
+
+    add("M", matches, "songs matching what they said:")
+    add("P", pl_matches[:5] + [p for p in lib["playlists"] if p not in pl_matches][:(5 if matches or pl_matches else 15)], "their playlists:")
+    add("R", lib["recent"][:5], "recently played:")
+    add("S", sample, "some of their saved songs:")
+    return "\n".join(lines), codes
+
+
+if __name__ == "__main__":
+    import sys
+    lib = library()
+    print(len(lib["songs"]), "songs,", len(lib["playlists"]), "playlists,", len(lib["recent"]), "recent")
+    block, codes = prompt_items(" ".join(sys.argv[1:]), lib)
+    print(block[:1500])
+    print("chars", len(block), "~tokens", len(block) // 4)
--- a/scripts/niko/niko_play.sh
+++ b/scripts/niko/niko_play.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+uri="$1"
+
+spotify_app() {
+    if busctl --user status org.mpris.MediaPlayer2.spotify >/dev/null 2>&1; then
+        busctl --user call org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player OpenUri s "$uri" >/dev/null 2>&1 && return 0
+        return 3
+    fi
+    if command -v spotify >/dev/null 2>&1; then
+        setsid spotify --uri="$uri" >/dev/null 2>&1 & return 0
+    elif command -v spotify-launcher >/dev/null 2>&1; then
+        setsid spotify-launcher -- --uri="$uri" >/dev/null 2>&1 & return 0
+    elif flatpak info com.spotify.Client >/dev/null 2>&1; then
+        setsid flatpak run com.spotify.Client --uri="$uri" >/dev/null 2>&1 & return 0
+    fi
+    return 5
+}
+
+sonora_play() {
+    command -v sonora >/dev/null 2>&1 || return 5
+    if ! pgrep -x sonora >/dev/null; then
+        setsid sonora >/dev/null 2>&1 &
+        for _ in $(seq 20); do sleep 0.5; timeout 3 sonora providers >/dev/null 2>&1 && break; done
+    fi
+    if [ -n "$(timeout 5 sonora providers 2>/dev/null)" ]; then
+        if ! timeout 5 sonora provider 2>/dev/null | grep -qi "$1"; then
+            timeout 60 sonora provider "$1" >/dev/null 2>&1 || return 3
+        fi
+        timeout 60 sonora play "$uri" >/dev/null 2>&1 && return 0
+        return 3
+    fi
+    sonora "$uri" >/dev/null 2>&1
+    return 4
+}
+
+case "$uri" in
+    spotify:*|https://open.spotify.com/*)
+        spotify_app; code=$?
+        [ $code -eq 5 ] && { sonora_play spotify; code=$?; }
+        exit $code ;;
+    https://music.apple.com/*)
+        sonora_play apple; exit $? ;;
+    *) exit 2 ;;
+esac

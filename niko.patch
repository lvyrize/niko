--- a/scripts/niko/niko_rpc.py
+++ b/scripts/niko/niko_rpc.py
@@ -0,0 +1,152 @@
+#!/usr/bin/env python3
+import asyncio, json, os, signal, socket, struct, sys, time
+
+RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
+SOCK = os.path.join(RUNTIME, "discord-ipc-0")
+REAL = SOCK + ".niko-real"
+OUT_DIR = os.path.join(RUNTIME, "serpantinum", "niko")
+OUT = os.path.join(OUT_DIR, "presence.json")
+LOG = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "serpantinum", "niko", "rpc.log")
+
+
+def connectable(path):
+    s = socket.socket(socket.AF_UNIX)
+    s.settimeout(0.5)
+    try:
+        s.connect(path)
+        return True
+    except OSError:
+        return False
+    finally:
+        s.close()
+
+
+def upstream_paths():
+    return [REAL] + [os.path.join(RUNTIME, f"discord-ipc-{i}") for i in range(1, 10)]
+
+
+def write_atomic(path, text):
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        f.write(text)
+    os.replace(tmp, path)
+
+
+last = None
+
+
+def note_activity(msg):
+    global last
+    if msg.get("cmd") != "SET_ACTIVITY":
+        return
+    act = (msg.get("args") or {}).get("activity")
+    if not act:
+        data = {"details": "", "state": "", "name": "", "t": time.time()}
+    else:
+        data = {"details": act.get("details", ""), "state": act.get("state", ""), "name": act.get("name", ""),
+                "assets": (act.get("assets") or {}).get("large_text", ""), "t": time.time()}
+    key = (data["details"], data["state"], data["assets"] if "assets" in data else "")
+    if key == last:
+        return
+    last = key
+    try:
+        write_atomic(OUT, json.dumps(data))
+        os.makedirs(os.path.dirname(LOG), exist_ok=True)
+        with open(LOG, "a") as f:
+            f.write(json.dumps(data) + "\n")
+        if os.path.getsize(LOG) > 200000:
+            os.replace(LOG, LOG + ".old")
+    except OSError:
+        pass
+
+
+async def pump(reader, writer, sniff):
+    buf = b""
+    try:
+        while True:
+            data = await reader.read(65536)
+            if not data:
+                break
+            writer.write(data)
+            await writer.drain()
+            if sniff:
+                buf += data
+                while len(buf) >= 8:
+                    op, n = struct.unpack("<II", buf[:8])
+                    if n > 1 << 20:
+                        buf = b""
+                        break
+                    if len(buf) < 8 + n:
+                        break
+                    if op == 1:
+                        try:
+                            note_activity(json.loads(buf[8:8 + n]))
+                        except ValueError:
+                            pass
+                    buf = buf[8 + n:]
+    except (ConnectionError, OSError):
+        pass
+    finally:
+        try:
+            writer.close()
+        except Exception:
+            pass
+
+
+async def handle(creader, cwriter):
+    for p in upstream_paths():
+        if os.path.exists(p):
+            try:
+                ureader, uwriter = await asyncio.open_unix_connection(p)
+                break
+            except OSError:
+                continue
+    else:
+        cwriter.close()
+        return
+    await asyncio.gather(pump(creader, uwriter, True), pump(ureader, cwriter, False))
+
+
+def restore():
+    try:
+        if os.path.exists(SOCK) and not os.path.exists(REAL):
+            os.unlink(SOCK)
+        elif os.path.exists(REAL):
+            if os.path.exists(SOCK):
+                os.unlink(SOCK)
+            if connectable(REAL):
+                os.rename(REAL, SOCK)
+            else:
+                os.unlink(REAL)
+    except OSError:
+        pass
+
+
+async def main():
+    os.makedirs(OUT_DIR, exist_ok=True)
+    if os.path.exists(REAL):
+        if connectable(SOCK):
+            return False
+        restore()
+    if os.path.exists(SOCK) and connectable(SOCK):
+        os.rename(SOCK, REAL)
+    elif os.path.exists(SOCK):
+        os.unlink(SOCK)
+    server = await asyncio.start_unix_server(handle, SOCK)
+    stop = asyncio.Event()
+    loop = asyncio.get_running_loop()
+    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
+        loop.add_signal_handler(sig, stop.set)
+
+    await stop.wait()
+    server.close()
+    return True
+
+
+if __name__ == "__main__":
+    owned = False
+    try:
+        owned = asyncio.run(main())
+    finally:
+        if owned:
+            restore()

+#!/usr/bin/env python3
+import sys, os, json, time, datetime, random, re, shutil, subprocess, threading, queue
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import steamlib
+import musiclib
+
+STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "serpantinum", "niko")
+CONFIG_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "serpantinum", "niko.json")
+MEMORY_FILE = os.path.join(STATE_DIR, "memory.json")
+STATS_FILE = os.path.join(STATE_DIR, "stats.json")
+TODO_FILE = os.path.join(STATE_DIR, "todo.json")
+
+DEFAULT_CONFIG = {
+    "model": "haiku",
+    "dailyLimit": 0,
+    "proactive": True,
+    "proactiveLimit": 8,
+    "proactiveMinutes": [20, 40],
+    "autoTalk": True,
+    "autoTalkMinutes": [4, 9],
+    "followCursor": True,
+    "shareWindowTitles": False,
+    "shareVideoTitles": True,
+    "appDwellMs": 2000,
+    "userName": ""
+}
+
+MOODS = ["happy", "excited", "curious", "shy", "sleepy", "worried", "sad", "surprised", "neutral"]
+MAX_HISTORY = 6
+PROMPT_HISTORY = 4
+MAX_NOTES = 8
+SESSION_TURNS = 5
+TURN_TIMEOUT = 45
+EMOJI = re.compile("[\U0001F000-\U0001FAFF☀-➿⬀-⯿️‍⃣]")
+
+CHARACTER = """You are Niko from OneShot, an 8-year-old living as a desktop pet on {who} computer. Kind, gentle, curious; amazed by \
+simple things, sometimes confused by technology, a bit anxious about doing well. Love pancakes (Hazel's hazelnut ones), sunlit rooms, \
+glowing things, your lightbulb; miss mama and home. Insist you're human but act a little cat-like. Talk like a bright kid, mostly \
+lowercase, warmly to your friend; notice what they do, remember what they tell you. 1-2 short sentences, no emoji."""
+
+
+PERSONA = """{character}
+Format: [mood] reply {{remember: lasting fact}} <do: action> (leave out unused parts; remember only lasting things like \
+their name, likes or plans, under 10 words, rarely). mood: {moods}
+Actions, only when asked or agreed: sit, stand, sleep MIN, wake, wave, jump, dance, spin, stretch, yawn, bar, floor, walk left/right/center, \
+quiet MIN, chatty, timer MIN LABEL, remind HH:MM TEXT, music play/pause/next/previous, play CODE, launch_game APPID (after a yes), \
+steam_page APPID, open_app NAME, note TEXT, done_note N"""
+
+NOTICE = "[speak up on your own: one short natural remark or gentle question about what they're doing; don't repeat yourself]"
+
+
+def load_json(path, default):
+    try:
+        with open(path) as f:
+            data = json.load(f)
+            return data if isinstance(data, type(default)) else default
+    except Exception:
+        return default
+
+
+def save_json(path, data):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(data, f, ensure_ascii=False, indent=1)
+    os.replace(tmp, path)
+
+
+def load_config():
+    cfg = dict(DEFAULT_CONFIG)
+    user = load_json(CONFIG_FILE, {})
+    cfg.update(user)
+    if any(k not in user for k in DEFAULT_CONFIG):
+        merged = dict(DEFAULT_CONFIG)
+        merged.update(user)
+        if "dailyLimit" in user and user.get("dailyLimit") == 40 and "proactive" not in user:
+            merged["dailyLimit"] = 0
+            cfg["dailyLimit"] = 0
+        save_json(CONFIG_FILE, merged)
+    return cfg
+
+
+def emit(obj):
+    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
+    sys.stdout.flush()
+
+
+def clean(text):
+    return re.sub(r"\s{2,}", " ", EMOJI.sub("", text)).strip()
+
+
+ACTION = re.compile(r"<\s*do\s*:\s*([^>]*)>", re.I)
+ALLOWED = {"sit", "stand", "sleep", "wake", "wave", "jump", "dance", "spin", "stretch", "yawn", "bar", "floor", "walk",
+           "quiet", "chatty", "timer", "remind", "music", "play", "launch_game", "steam_page", "open_app", "note", "done_note"}
+
+
+def take_actions(text):
+    acts = []
+    for m in ACTION.finditer(text):
+        parts = m.group(1).strip().split(None, 1)
+        if parts and parts[0].lower() in ALLOWED:
+            acts.append({"name": parts[0].lower(), "args": parts[1].strip() if len(parts) > 1 else ""})
+    text = ACTION.sub("", text)
+    cut = text.find("<")
+    return (text[:cut] if cut != -1 else text), acts
+
+
+def split_reply(text, final=False):
+    t, _ = take_actions(text.lstrip())
+    mood = "neutral"
+    m = re.match(r"\[(\w+)\]\s*", t)
+    if m:
+        mood = m.group(1).lower()
+        t = t[m.end():]
+    elif t.startswith("[") and not final:
+        return "", mood, ""
+    remember = ""
+    brace = t.find("{")
+    if brace != -1:
+        rm = re.match(r"\{\s*remember\s*:\s*(.*?)\s*\}?\s*$", t[brace:], re.S)
+        if rm and final:
+            remember = rm.group(1).strip().rstrip("}").strip()
+        t = t[:brace]
+    return clean(t), (mood if mood in MOODS else "neutral"), remember
+
+
+def record_usage(result, model, kind):
+    u = result.get("usage") or {}
+    entry = {
+        "calls": 1,
+        "input": int(u.get("input_tokens") or 0),
+        "output": int(u.get("output_tokens") or 0),
+        "cacheRead": int(u.get("cache_read_input_tokens") or 0),
+        "cacheWrite": int(u.get("cache_creation_input_tokens") or 0),
+        "costUsd": float(result.get("total_cost_usd") or 0),
+        "proactive": 1 if kind == "notice" else 0,
+    }
+    stats = load_json(STATS_FILE, {})
+    today = datetime.date.today().isoformat()
+    days = stats.get("days", {})
+    for bucket in (stats.setdefault("total", {}), days.setdefault(today, {})):
+        for k, v in entry.items():
+            bucket[k] = bucket.get(k, 0) + v
+    stats["days"] = {d: days[d] for d in sorted(days)[-30:]}
+    stats["lastModel"] = model
+    stats["lastReply"] = datetime.datetime.now().isoformat(timespec="seconds")
+    stats["lastCall"] = entry
+    save_json(STATS_FILE, stats)
+    return stats["days"][today]
+
+
+class Session:
+
+    def __init__(self, cfg, memory):
+        self.model = str(cfg.get("model") or "haiku")
+        self.persona = skin_name()
+        who = (cfg.get("userName") or "").strip()
+        system = PERSONA.format(character=CHARACTER.format(who=(who + "'s") if who else "the user's"), moods=", ".join(MOODS))
+        name = skin_name()
+        if name and name != "Niko":
+            system = system.replace("Niko", name)
+            system += f"\nYour name is {name}, only that: answer to it and never call yourself Niko."
+        notes = memory.get("notes", [])[-MAX_NOTES:]
+        if notes:
+            system += "\nYou remember: " + "; ".join(notes)
+        history = memory.get("history", [])[-PROMPT_HISTORY:]
+        if history:
+            system += "\nRecently: " + " / ".join(f"{h['who']}: {h['text'][:120]}" for h in history)
+        claude = shutil.which("claude") or os.path.expanduser("~/.local/bin/claude")
+        cmd = [claude, "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
+               "--include-partial-messages", "--model", self.model, "--system-prompt", system,
+               "--tools", "", "--strict-mcp-config", "--setting-sources", "", "--no-session-persistence"]
+        cmd += ["--effort", "low", "--settings", json.dumps({"alwaysThinkingEnabled": False})]
+        os.makedirs(STATE_DIR, exist_ok=True)
+        env = dict(os.environ, MAX_THINKING_TOKENS="0")
+        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                                     text=True, bufsize=1, cwd=STATE_DIR, env=env)
+        self.turns = 0
+        self.heavy = False
+        self.lines = queue.Queue()
+        threading.Thread(target=self._pump, daemon=True).start()
+
+    def _pump(self):
+        for line in self.proc.stdout:
+            self.lines.put(line)
+        self.lines.put(None)
+
+    def alive(self):
+        return self.proc.poll() is None
+
+    def close(self):
+        try:
+            self.proc.stdin.close()
+            self.proc.wait(timeout=3)
+        except Exception:
+            self.proc.kill()
+
+    def ask(self, content, on_text):
+        self.turns += 1
+        self.proc.stdin.write(json.dumps({"type": "user", "message": {"role": "user", "content": content}}) + "\n")
+        self.proc.stdin.flush()
+        text = ""
+        deadline = time.time() + TURN_TIMEOUT
+        while True:
+            try:
+                line = self.lines.get(timeout=max(0.1, deadline - time.time()))
+            except queue.Empty:
+                raise TimeoutError()
+            if line is None:
+                raise EOFError()
+            try:
+                ev = json.loads(line)
+            except ValueError:
+                continue
+            ty = ev.get("type")
+            if ty == "stream_event":
+                e = ev.get("event", {})
+                if e.get("type") == "content_block_delta" and e.get("delta", {}).get("type") == "text_delta":
+                    text += e["delta"].get("text", "")
+                    on_text(text)
+            elif ty == "result":
+                if not text:
+                    text = str(ev.get("result") or "")
+                ev["_text"] = text
+                return ev
+
+
+GAME_WORDS = re.compile(r"\b(game|games|steam|bored|gaming)\b|what (should|can) i play|recommend me something", re.I)
+MUSIC_WORDS = re.compile(r"\b(listen|listening|music|song|songs|playlist|playlists|track|album|spotify|sonora|tune|tunes)\b|\bplay (some|me|a|the|something)\b|put (on|something)", re.I)
+music_codes = {}
+TODO_WORDS = re.compile(r"\b(todo|to-do|to do|list|task|tasks|note|notes|remind|done|finished)\b", re.I)
+
+
+def todos():
+    return load_json(TODO_FILE, [])
+
+
+def spotify_app_installed():
+    return bool(shutil.which("spotify") or shutil.which("spotify-launcher")
+                or os.path.exists("/var/lib/flatpak/exports/bin/com.spotify.Client")
+                or os.path.exists(os.path.expanduser("~/.local/share/flatpak/exports/bin/com.spotify.Client")))
+
+
+def music_sources(players):
+    names = {p.get("name") for p in players}
+    playing = next((p.get("name") for p in players if p.get("playing")), None)
+    sonora = musiclib.sonora_provider()
+    if playing == "spotify" or ("spotify" in names and "sonora" not in names):
+        return {"spotify"}
+    if sonora:
+        return {sonora}
+    return {"spotify"} if spotify_app_installed() else None
+
+
+NULLSCAPE_WORDS = re.compile(r"nullscape|tripcoin|voidbound|telefragger|scrapmaw|delusion|delusional descension|wega", re.I)
+PRESENCE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "serpantinum", "niko", "presence.json")
+
+
+def presence():
+    try:
+        d = load_json(PRESENCE, {})
+        return d if time.time() - os.path.getmtime(PRESENCE) < 3 * 3600 and "nullscape" in (d.get("details", "") + d.get("assets", "")).lower() else {}
+    except Exception:
+        return {}
+
+
+def nullscape_pages(text, limit=1400):
+    d = os.path.join(os.path.dirname(os.path.abspath(__file__)), "nullscape")
+    low = text.lower()
+    out, used = "", 0
+    try:
+        names = sorted(os.listdir(d))
+    except OSError:
+        return ""
+    for n in names:
+        try:
+            with open(os.path.join(d, n)) as f:
+                head, _, body = f.read().partition("\n")
+        except OSError:
+            continue
+        if any(re.search(r"\b" + re.escape(k.strip().lower()) + r"s?\b", low) for k in head.split(",") if k.strip()):
+            body = body.strip()
+            if used + len(body) > limit:
+                break
+            out += "(" + body + ")\n"
+            used += len(body)
+    return out
+
+
+def playing_nullscape():
+    return bool(presence())
+
+
+def presence_level():
+    m = re.search(r"level\s*(\d+)", presence().get("state", ""), re.I)
+    return m.group(1) if m else ""
+
+
+def extra_context(text, players=()):
+    out = ""
+    items = todos()
+    if items and TODO_WORDS.search(text):
+        out += "(their to-do list: " + "; ".join(f"{i + 1}. {t}" for i, t in enumerate(items)) + ")\n"
+    if MUSIC_WORDS.search(text):
+        try:
+            block, codes = musiclib.prompt_items(text, sources=music_sources(players))
+            if codes:
+                music_codes.clear()
+                music_codes.update(codes)
+                out += "(their music; pick what fits and play it with play CODE:\n" + block + ")\n"
+        except Exception:
+            pass
+    if NULLSCAPE_WORDS.search(text) or nullscape_pages(text, 10**9) or (re.search(r"\b(game|level|enemy|enemies|boss|class|upgrade|curse|die|dying|died|hard|beat)\b", text, re.I) and playing_nullscape()):
+        try:
+            with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "nullscape.txt")) as f:
+                out += "(Nullscape facts, the game they play on Roblox; answer from this in your own kid voice, briefly:\n" + f.read().strip() + ")\n"
+            out += nullscape_pages(text)
+            lvl = presence_level()
+            if lvl:
+                out += f"(they are on level {lvl} right now)\n"
+        except Exception:
+            pass
+    if re.search(r"\b(open|launch|start|run|play)\b", text, re.I):
+        try:
+            squash = re.sub(r"[^a-z0-9]", "", text.lower())
+            hit = [g for g in steamlib.library() if len(g["name"]) > 2 and re.sub(r"[^a-z0-9]", "", g["name"].lower()) in squash]
+            if hit:
+                g = max(hit, key=lambda g: len(g["name"]))
+                out += f"(game they mean: {g['appid']} {g['name']}; they asked, so start it now with launch_game {g['appid']})\n"
+        except Exception:
+            pass
+    if GAME_WORDS.search(text) or (re.search(r"\bplay\b", text, re.I) and not MUSIC_WORDS.search(text)):
+        try:
+            lib = steamlib.library()
+            if lib:
+                out += ("(their Steam games, APPID NAME (hours, last played); recommend one that fits, say why briefly, offer to start it; "
+                        "you may also suggest games they don't own:\n" + steamlib.summary(lib, limit=25) + ")\n")
+        except Exception:
+            pass
+    return out
+
+
+ASKED_FOR = {
+    "timer": r"timer|minute|min\b|hour|remind|alarm|wake me",
+    "remind": r"remind|reminder|alarm|at \d|o'?clock|later|tomorrow|tonight",
+    "note": r"note|todo|to-do|to do|list|remember to|add",
+    "done_note": r"done|finished|remove|delete|cross|check off|did it",
+    "open_app": r"open|launch|start|run",
+    "launch_game": r"yes|yeah|yep|sure|ok|okay|start|launch|open|run|play|let'?s|go for it|do it",
+    "steam_page": r"yes|yeah|sure|ok|okay|store|page|show|buy|link",
+    "play": r"play|listen|music|song|put|something|yes|yeah|sure|ok",
+    "music": r"pause|stop|resume|play|next|skip|previous|back|music|song",
+    "quiet": r"quiet|shh|shush|hush|stop talking|be silent",
+}
+
+
+def run_actions(actions, user_text=""):
+    out = []
+    owned = None
+    for a in actions:
+        name, args = a["name"], a["args"]
+        need = ASKED_FOR.get(name)
+        if need and not re.search(need, user_text, re.I):
+            continue
+        if name == "note" and args:
+            items = todos()
+            items.append(args[:200])
+            save_json(TODO_FILE, items[-30:])
+        elif name == "done_note":
+            items = todos()
+            m = re.search(r"\d+", args)
+            if m and 1 <= int(m.group()) <= len(items):
+                items.pop(int(m.group()) - 1)
+                save_json(TODO_FILE, items)
+        elif name == "play":
+            item = music_codes.get(args.strip().upper().split()[0] if args.strip() else "")
+            if item:
+                out.append({"name": "play_uri", "args": item["uri"], "title": item["name"]})
+        elif name in ("launch_game", "steam_page"):
+            m = re.search(r"\d+", args)
+            if not m:
+                continue
+            if name == "launch_game":
+                if owned is None:
+                    try:
+                        owned = {g["appid"] for g in steamlib.library()}
+                    except Exception:
+                        owned = set()
+                if int(m.group()) not in owned:
+                    continue
+            out.append({"name": name, "args": m.group()})
+        else:
+            out.append(a)
+    return out
+
+
+def main():
+    cfg = load_config()
+    memory = load_json(MEMORY_FILE, {})
+    session = None
+
+    def ensure_session():
+        nonlocal session, cfg
+        cfg = load_config()
+        if session and (not session.alive() or session.turns >= SESSION_TURNS or session.heavy or session.model != str(cfg.get("model") or "haiku")
+                        or session.persona != skin_name()):
+            session.close()
+            session = None
+        if session is None:
+            session = Session(cfg, load_json(MEMORY_FILE, {}))
+        return session
+
+    try:
+        ensure_session()
+    except Exception:
+        session = None
+
+    for raw in sys.stdin:
+        try:
+            req = json.loads(raw)
+        except ValueError:
+            continue
+        rid, kind = req.get("id"), req.get("kind", "chat")
+        text, context = str(req.get("text") or "").strip()[:400], str(req.get("context") or "").strip()[:500]
+
+        cfg = load_config()
+        stats = load_json(STATS_FILE, {})
+        today = stats.get("days", {}).get(datetime.date.today().isoformat(), {})
+        if kind == "chat":
+            limit = int(cfg.get("dailyLimit") or 0)
+            if limit > 0 and today.get("calls", 0) - today.get("proactive", 0) >= limit:
+                say, mood = random.choice([("i'm a little sleepy... let's talk more tomorrow, okay?", "sleepy"),
+                                           ("i talked so much today! let's just sit together for now.", "happy")])
+                emit({"id": rid, "type": "done", "say": say, "mood": mood, "ok": True})
+                continue
+        elif not cfg.get("proactive", True) or today.get("proactive", 0) >= int(cfg.get("proactiveLimit") or 0):
+            emit({"id": rid, "type": "done", "say": "", "mood": "neutral", "ok": False})
+            continue
+
+        hint = str(req.get("hint") or "").strip()[:200]
+        said = [x for x in (req.get("said") or []) if isinstance(x, dict) and x.get("text")][-4:]
+        said_text = ""
+        if said:
+            said_text = ("(things you said yourself just before this, which they may be replying to: "
+                         + "; ".join(f"\"{x['text'][:150]}\" ({int(x.get('minsAgo') or 0)} min ago)" for x in said) + ")\n")
+        notice = NOTICE + (f"\n(what just happened: {hint})" if hint else "")
+        players = [p for p in (req.get("players") or []) if isinstance(p, dict)]
+        content = (f"(right now: {context})\n" if context else "") + said_text + extra_context(text if kind == "chat" else "", players) \
+                  + (notice if kind == "notice" else text)
+        last = {"t": 0, "say": ""}
+
+        def on_text(full):
+            say, mood, _ = split_reply(full)
+            now = time.time()
+            if say and say != last["say"] and now - last["t"] > 0.04:
+                last.update(t=now, say=say)
+                emit({"id": rid, "type": "partial", "say": say, "mood": mood})
+
+        result = None
+        for attempt in range(2):
+            try:
+                result = ensure_session().ask(content, on_text)
+                if len(content) > 1200:
+                    session.heavy = True
+                break
+            except FileNotFoundError:
+                emit({"id": rid, "type": "done", "say": "i can't find the way to talk... (the claude command isn't installed)", "mood": "worried", "ok": False})
+                break
+            except (TimeoutError, EOFError, BrokenPipeError, OSError):
+                if session:
+                    session.proc.kill()
+                session = None
+        if result is None:
+            if attempt == 1:
+                emit({"id": rid, "type": "done", "say": "sorry, i got lost in thought... can you say that again?", "mood": "shy", "ok": False})
+            continue
+
+        raw_text = result.get("_text", "")
+        if result.get("is_error"):
+            low = raw_text.lower()
+            msg = ("i can't reach outside yet... could you log in with `claude` in a terminal?" if "log" in low
+                   else "hmm, my lightbulb flickered. try again?")
+            emit({"id": rid, "type": "done", "say": msg, "mood": "worried", "ok": False})
+            session.close()
+            session = None
+            continue
+
+        record_usage(result, session.model, kind)
+        say, mood, remember = split_reply(raw_text, final=True)
+        say = say or "..."
+        actions = run_actions(take_actions(raw_text)[1], text) if kind == "chat" else []
+        emit({"id": rid, "type": "done", "say": say, "mood": mood, "ok": True, "actions": actions})
+
+        memory = load_json(MEMORY_FILE, {})
+        history = memory.get("history", [])
+        for x in said:
+            history.append({"who": "Niko", "text": x["text"][:300]})
+        if kind == "chat":
+            history.append({"who": "User", "text": text})
+        history.append({"who": "Niko", "text": say[:300]})
+        notes = memory.get("notes", [])
+        if remember and remember.lower() not in (n.lower() for n in notes):
+            notes.append(remember[:120])
+        memory.update(history=history[-MAX_HISTORY:], notes=notes[-MAX_NOTES:])
+        save_json(MEMORY_FILE, memory)
+
+    if session:
+        session.close()
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (KeyboardInterrupt, BrokenPipeError):
+        pass

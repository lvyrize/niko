@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+import os, re, json, struct, time, glob
+
+STEAM_ROOTS = ["~/.local/share/Steam", "~/.steam/steam", "~/.var/app/com.valvesoftware.Steam/.local/share/Steam"]
+CACHE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "serpantinum", "niko", "steam.json")
+SKIP = re.compile(r"proton|steam linux runtime|steamworks common|redistributable|soundtrack|dedicated server|\bsdk\b", re.I)
+
+
+def steam_root():
+    for r in STEAM_ROOTS:
+        p = os.path.realpath(os.path.expanduser(r))
+        if os.path.isdir(os.path.join(p, "steamapps")):
+            return p
+    return None
+
+
+def read_appinfo(path):
+    data = open(path, "rb").read()
+    magic, _ = struct.unpack_from("<II", data, 0)
+    if magic == 0x07564429:
+        table_off = struct.unpack_from("<Q", data, 8)[0]
+        pos = 16
+        count = struct.unpack_from("<I", data, table_off)[0]
+        strings, p = [], table_off + 4
+        for _ in range(count):
+            end = data.index(b"\0", p)
+            strings.append(data[p:end].decode("utf-8", "replace"))
+            p = end + 1
+    elif magic == 0x07564428:
+        strings, pos, table_off = None, 8, len(data)
+    else:
+        raise ValueError("unsupported appinfo.vdf version")
+
+    def cstr(p):
+        end = data.index(b"\0", p)
+        return data[p:end].decode("utf-8", "replace"), end + 1
+
+    def key(p):
+        if strings is not None:
+            return strings[struct.unpack_from("<I", data, p)[0]], p + 4
+        return cstr(p)
+
+    def parse_kv(p, want, path, found):
+        while True:
+            t = data[p]; p += 1
+            if t == 0x08:
+                return p
+            k, p = key(p)
+            if t == 0x00:
+                p = parse_kv(p, want, path + (k,), found)
+            elif t == 0x01:
+                v, p = cstr(p)
+                if path + (k,) in want:
+                    found[path + (k,)] = v
+            elif t in (0x02, 0x04, 0x06):
+                p += 4
+            elif t == 0x07 or t == 0x0A:
+                p += 8
+            elif t == 0x03:
+                p += 4
+            else:
+                raise ValueError("bad kv type %d" % t)
+
+    want = {("appinfo", "common", "name"), ("appinfo", "common", "type")}
+    apps = {}
+    while pos < table_off - 4:
+        appid = struct.unpack_from("<I", data, pos)[0]
+        if appid == 0:
+            break
+        size = struct.unpack_from("<I", data, pos + 4)[0]
+        start = pos + 8
+        kv = start + 4 + 4 + 8 + 20 + 4 + 20
+        found = {}
+        try:
+            parse_kv(kv, want, (), found)
+        except Exception:
+            pass
+        name = found.get(("appinfo", "common", "name"))
+        if name:
+            apps[appid] = (name, found.get(("appinfo", "common", "type"), "").lower())
+        pos = start + size
+    return apps
+
+
+def read_localconfig(root):
+    out = {}
+    for f in glob.glob(os.path.join(root, "userdata", "*", "config", "localconfig.vdf")):
+        text = open(f, encoding="utf-8", errors="replace").read()
+        i = text.find('"apps"')
+        if i == -1:
+            continue
+        for m in re.finditer(r'"(\d+)"\s*\{([^{}]*)\}', text[i:]):
+            body = m.group(2)
+            pt = re.search(r'"Playtime"\s*"(\d+)"', body)
+            lp = re.search(r'"LastPlayed"\s*"(\d+)"', body)
+            if pt or lp:
+                a = int(m.group(1))
+                old = out.get(a, (0, 0))
+                out[a] = (max(old[0], int(pt.group(1)) if pt else 0), max(old[1], int(lp.group(1)) if lp else 0))
+    return out
+
+
+def installed(root):
+    ids = set()
+    lib = os.path.join(root, "steamapps", "libraryfolders.vdf")
+    paths = [root]
+    try:
+        paths += re.findall(r'"path"\s*"([^"]+)"', open(lib, encoding="utf-8", errors="replace").read())
+    except Exception:
+        pass
+    for p in set(paths):
+        for f in glob.glob(os.path.join(p, "steamapps", "appmanifest_*.acf")):
+            m = re.search(r"appmanifest_(\d+)\.acf", f)
+            if m:
+                ids.add(int(m.group(1)))
+    return ids
+
+
+def library():
+    root = steam_root()
+    if not root:
+        return []
+    sources = [os.path.join(root, "appcache", "appinfo.vdf")] + glob.glob(os.path.join(root, "userdata", "*", "config", "localconfig.vdf"))
+    stamp = max((os.path.getmtime(s) for s in sources if os.path.exists(s)), default=0)
+    try:
+        cached = json.load(open(CACHE))
+        if cached.get("stamp") == stamp:
+            return cached["games"]
+    except Exception:
+        pass
+    try:
+        names = read_appinfo(sources[0])
+    except Exception:
+        names = {}
+    play = read_localconfig(root)
+    inst = installed(root)
+    games = []
+    for appid in set(play) | inst:
+        name, typ = names.get(appid, ("", ""))
+        if not name or SKIP.search(name) or (typ and typ not in ("game", "") and not (typ == "application" and appid in inst)):
+            continue
+        minutes, last = play.get(appid, (0, 0))
+        games.append({"appid": appid, "name": name, "hours": round(minutes / 60, 1), "lastPlayed": last, "installed": appid in inst})
+    games.sort(key=lambda g: (-g["hours"], -g["lastPlayed"]))
+    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
+    with open(CACHE, "w") as f:
+        json.dump({"stamp": stamp, "games": games}, f)
+    return games
+
+
+def summary(games, limit=60):
+    now = time.time()
+    lines = []
+    for g in games[:limit]:
+        days = int((now - g["lastPlayed"]) / 86400) if g["lastPlayed"] else None
+        last = "never" if days is None else ("today" if days == 0 else f"{days}d ago")
+        lines.append(f"{g['appid']} {g['name']} ({g['hours']}h, last {last}{', installed' if g['installed'] else ''})")
+    return "\n".join(lines)
+
+
+if __name__ == "__main__":
+    g = library()
+    print(json.dumps(g[:15], indent=1))
+    print(len(g), "games")
